# Dev server (optional; scripts/start-dev.js sets these if unset):
# DISABLE_ESLINT_PLUGIN=true
# WATCHPACK_POLLING=true
# HOST=localhost

# Copy to .env.local and set your OAuth 2.0 Web Client ID from Google Cloud Console.
# APIs & Services > Credentials > Create OAuth client ID (Web application)
# Authorized JavaScript origins (add every URL you use — host and port must match exactly):
#   http://localhost:3000
#   http://localhost:3001
#   http://127.0.0.1:3000
#   http://127.0.0.1:3001
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
